{
  "version": 1,
  "conventions": {
    "actingPaths": [
      "apps/**",
      "services/**",
      "packages/**",
      "cmd/**",
      "crates/**",
      "tools/security-toolchains/**"
    ],
    "excludePaths": [
      "**/examples/**",
      "**/example/**",
      "**/testdata/**",
      "**/tests/**",
      "**/test/**",
      "**/__tests__/**",
      "**/fixtures/**",
      "**/*fixture*/**",
      "**/vendor/**",
      "**/third_party/**",
      "**/.archive/**",
      "tools/sca/**",
      "dogfood/**"
    ],
    "actingTrack": "cadence",
    "excludedTrack": "report-only",
    "unclassifiedTrack": "report-only"
  },
  "manifests": [
    {
      "path": "Cargo.lock",
      "ecosystem": "crates.io",
      "parser": "Cargo.lock",
      "track": "cadence"
    },
    {
      "path": "tools/security-toolchains/cargo-audit/Cargo.lock",
      "ecosystem": "crates.io",
      "parser": "Cargo.lock",
      "track": "cadence",
      "note": "Source-verified frozen security-tool graph; scanned before build, no automatic remediation authority."
    },
    {
      "path": "tools/security-toolchains/cargo-deny/Cargo.lock",
      "ecosystem": "crates.io",
      "parser": "Cargo.lock",
      "track": "cadence",
      "note": "Source-verified frozen security-tool graph; scanned before build, no automatic remediation authority."
    },
    {
      "path": "tools/security-toolchains/cargo-vet/Cargo.lock",
      "ecosystem": "crates.io",
      "parser": "Cargo.lock",
      "track": "cadence",
      "note": "Source-verified frozen security-tool graph; scanned before build, no automatic remediation authority."
    },
    {
      "path": "tools/security-toolchains/kani-verifier/Cargo.lock",
      "ecosystem": "crates.io",
      "parser": "Cargo.lock",
      "track": "cadence",
      "note": "Source-verified frozen security-tool graph; scanned before build, no automatic remediation authority."
    },
    {
      "path": "tools/security-toolchains/semgrep/requirements.txt",
      "ecosystem": "PyPI",
      "parser": "requirements.txt",
      "track": "cadence",
      "note": "Hash-pinned Linux x86_64/Python3.11 wheel-only graph, admitted before Semgrep installation."
    }
  ]
}
